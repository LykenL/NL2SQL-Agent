# ── Chat model (any OpenAI-compatible endpoint) ─────────────────────────────
# DeepSeek by default. LLM_API_KEY has no fallback: the app fails at the first
# call rather than running with an empty key.
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
AGENT_MODEL="deepseek-chat"      # or deepseek-reasoner

# Legacy names kept for a local Ollama server:
# OLLAMA_API_KEY / OLLAMA_BASE_URL are used by the embedding code only.

# ── Langfuse tracing (optional) ──────────────────────────────────────────────
# Leave both empty to disable tracing entirely: every trace helper is a no-op
# and the app runs as before. Keys: Langfuse project -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"   # EU; use https://us.cloud.langfuse.com for US

# 你的 Google Gemini API Key
# 申请地址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourApiKeyHere..."

# ── BigQuery data source ─────────────────────────────────────────────────────
# Datasets exposed in the UI as "BigQuery" sources (comma separated). The part
# before the dot is the project that OWNS the data (may be a public project).
BIGQUERY_DATASETS="my-project.analytics,bigquery-public-data.usa_names"
# Project that pays for query jobs. Defaults to the data project; must be set
# when reading public datasets.
BIGQUERY_BILLING_PROJECT="my-billing-project"
BIGQUERY_LOCATION="US"
# Service-account JSON. On Render: add a Secret File and point this at its path,
# e.g. /etc/secrets/gcp-sa.json
GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/gcp-sa.json"
# Hard per-query cap (bytes). Queries estimated above this are flagged OVER BUDGET.
BQ_MAX_BYTES="20000000000"
